<UserControl x:Class="CabinetMedical.Views.Client.ClientDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

       
        <WrapPanel Grid.Row="0" 
                   HorizontalAlignment="Center" 
                   Margin="30">
            
            <Border Width="220" 
                    Height="120" 
                    Background="#1abc9c" 
                    CornerRadius="10" 
                    Margin="10">
                
                <StackPanel VerticalAlignment="Center">
                    
                    <TextBlock Text="Programări Active" 
                               Foreground="White" 
                               HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="{Binding ProgramariActive}"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    
                </StackPanel>
                
            </Border>

            <Border Width="300" 
                    Height="120" 
                    Background="#e74c3c" 
                    CornerRadius="10" 
                    Margin="10">
                
                <StackPanel VerticalAlignment="Center">
                    
                    <TextBlock Text="Următoarea Programare" 
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="{Binding UrmatoareaProgramare}" 
                               Foreground="White" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               TextWrapping="Wrap" 
                               Margin="10,5"/>
                    
                </StackPanel>
                
            </Border>
        </WrapPanel>

        
        <TextBlock Grid.Row="1" 
                   Text="Programările tale viitoare" 
                   FontSize="20"
                   FontWeight="Bold" 
                   Foreground="#2C3E50"
                   Margin="40,0,30,10"/>

        
        <Border Grid.Row="2" 
                Background="White" 
                Margin="40,0,40,30" 
                CornerRadius="10">
            
            <Border.Effect>
                <DropShadowEffect BlurRadius="15"
                                  Direction="270" 
                                  ShadowDepth="2" 
                                  Opacity="0.1"/>
            </Border.Effect>

            <DataGrid ItemsSource="{Binding ProgramariViitoare}" 
                      IsReadOnly="True"
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      GridLinesVisibility="Horizontal" 
                      Background="White" 
                      BorderThickness="0"
                      Margin="10"
                      HeadersVisibility="Column"
                      RowHeight="35">

                <DataGrid.Resources>
                    
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                    </Style>
                    
                </DataGrid.Resources>

                <DataGrid.Columns>
                    
                    <DataGridTextColumn Header="Consultație" 
                                        Binding="{Binding Serviciu.Denumire}" 
                                        Width="2*"/>
                    
                    <DataGridTextColumn Header="Data"
                                        Binding="{Binding DataOra, StringFormat='{}{0:dd MMM yyyy}'}" 
                                        Width="*"/>
                    
                    <DataGridTextColumn Header="Ora" 
                                        Binding="{Binding DataOra, StringFormat='{}{0:HH:mm}'}" 
                                        Width="*"/>
                    
                    <DataGridTextColumn Header="Preț"
                                        Binding="{Binding Serviciu.Pret, StringFormat='{}{0:F2} RON'}"
                                        Width="*">
                        
                        <DataGridTextColumn.ElementStyle>
                            
                            <Style TargetType="TextBlock">
                                
                                <Setter Property="FontWeight"
                                        Value="Bold"/>
                                
                                <Setter Property="Foreground"
                                        Value="#00B4D8"/>
                                
                            </Style>
                            
                        </DataGridTextColumn.ElementStyle>
                        
                    </DataGridTextColumn>
                    
                </DataGrid.Columns>
                
            </DataGrid>
        </Border>
    </Grid>
</UserControl>