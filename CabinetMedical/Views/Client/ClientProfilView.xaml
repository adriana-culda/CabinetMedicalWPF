<UserControl x:Class="CabinetMedical.Views.Client.ClientProfilView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800">

    <Grid Background="#F5F7FA">
        
        <StackPanel Margin="30">
            
            <TextBlock Text="Profilul Meu" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Foreground="#2C3E50"
                       Margin="0,0,0,5"/>
            
            <TextBlock Text="Actualizează-ți datele de contact." 
                       Foreground="Gray"
                       Margin="0,0,0,20"/>
            
            <Border Background="White" 
                    CornerRadius="10" 
                    Padding="40" 
                    MaxWidth="600" 
                    HorizontalAlignment="Left">
                
                <Border.Effect>
                    
                    <DropShadowEffect BlurRadius="15" 
                                      Direction="270" 
                                      ShadowDepth="2" 
                                      Opacity="0.1"/>
                </Border.Effect>

                <StackPanel Width="500">
                    
                    <TextBlock Text="Nume" 
                               FontWeight="SemiBold"
                               Foreground="#34495E" 
                               Margin="0,0,0,5"/>
                    
                    <TextBox Text="{Binding Nume}"
                             Height="35"
                             Margin="0,0,0,15" 
                             VerticalContentAlignment="Center"
                             Padding="5,0"/>

                    <TextBlock Text="Prenume"
                               FontWeight="SemiBold" 
                               Foreground="#34495E" 
                               Margin="0,0,0,5"/>
                    
                    <TextBox Text="{Binding Prenume}" 
                             Height="35" 
                             Margin="0,0,0,15" 
                             VerticalContentAlignment="Center"
                             Padding="5,0"/>

                    <TextBlock Text="Telefon"
                               FontWeight="SemiBold"
                               Foreground="#34495E"
                               Margin="0,0,0,5"/>
                    
                    <TextBox Text="{Binding Telefon}" 
                             Height="35" 
                             Margin="0,0,0,25" 
                             VerticalContentAlignment="Center" 
                             Padding="5,0"/>

                    <Button Content="Salvează Modificările" 
                            Command="{Binding SalveazaProfilCommand}" 
                            Height="45" 
                            Background="#1abc9c" 
                            Foreground="White" 
                            FontWeight="Bold" 
                            BorderThickness="0" 
                            Cursor="Hand"/>
                    
                </StackPanel>
                
            </Border>
            
        </StackPanel>
        
    </Grid>
</UserControl>