<UserControl x:Class="CabinetMedical.Views.Client.ClientServiciiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800">

    <Grid Background="#F5F7FA">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" 
                    Margin="20,20,20,10">
            
            <TextBlock Text="Servicii Medicale" 
                       FontSize="20" 
                       FontWeight="Bold"
                       Foreground="#2C3E50"/>
            
            <TextBlock Text="Lista completă a serviciilor și prețurilor cabinetului nostru." 
                       Foreground="Gray" 
                       Margin="0,5,0,0"/>
            
        </StackPanel>

        <StackPanel Grid.Row="1" 
                    Margin="20,0,20,0"
                    Orientation="Horizontal">

            <TextBlock Text="Caută serviciu:"
                       VerticalAlignment="Center" 
                       Margin="0,0,10,0" 
                       FontWeight="SemiBold"/>
            
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     Width="300"
                     Height="30" 
                     VerticalContentAlignment="Center"
                     Padding="5,0"/>
            
        </StackPanel>

        <Border Grid.Row="2" 
                Background="White"
                Margin="20,10,20,20" 
                CornerRadius="10">
            
            <Border.Effect>
                
                <DropShadowEffect BlurRadius="15" 
                                  Direction="270" 
                                  ShadowDepth="2" 
                                  Opacity="0.1"/>
            </Border.Effect>

            <DataGrid ItemsSource="{Binding ListaServicii}" 
                     IsReadOnly="True"
                     AutoGenerateColumns="False" 
                     CanUserAddRows="False" 
                     GridLinesVisibility="Horizontal" 
                     Background="White" 
                     BorderThickness="0"
                     Margin="10"
                     HeadersVisibility="Column"
                     RowHeight="35">

                <DataGrid.Resources>
                    
                    <Style TargetType="DataGridColumnHeader">
                        
                        <Setter Property="Background" 
                                Value="White"/>
                        
                        <Setter Property="FontWeight"
                                Value="Bold"/>
                        
                        <Setter Property="Padding"
                                Value="10,5"/>
                        
                        <Setter Property="BorderThickness"
                                Value="0,0,0,1"/>
                        
                        <Setter Property="BorderBrush"
                                Value="#E0E0E0"/>
                        
                    </Style>
                    
                </DataGrid.Resources>

                <DataGrid.Columns>
                    
                    <DataGridTextColumn Header="Denumire" 
                                        Binding="{Binding Denumire}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="Categorie" 
                                        Binding="{Binding Categorie}" 
                                        Width="3*"/>

                    <DataGridTextColumn Header="Preț (RON)"
                                        Binding="{Binding Pret, StringFormat='{}{0:F2} RON'}" 
                                        Width="*">
                        
                        <DataGridTextColumn.ElementStyle>
                            
                            <Style TargetType="TextBlock">
                                
                                <Setter Property="FontWeight"
                                        Value="Bold"/>
                                <Setter Property="Foreground" 
                                        Value="#00B4D8"/>
                                
                            </Style>
                            
                        </DataGridTextColumn.ElementStyle>
                        
                    </DataGridTextColumn>
                    
                </DataGrid.Columns>
                
            </DataGrid>
        </Border>
    </Grid>
</UserControl>