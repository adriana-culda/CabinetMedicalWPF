<UserControl x:Class="CabinetMedical.Views.Admin.AdminRapoarteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="540" d:DesignWidth="780">

    <Grid Background="#F5F7FA">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" 
                    Margin="20,20,20,10">

            <TextBlock Text="Istoric încasări"
                       FontSize="20" 
                       FontWeight="Bold"
                       Foreground="#2C3E50"/>
            
            <TextBlock Text="Vizualizează istoricul consultațiilor și încasările aferente." 
                       Foreground="Gray" 
                       Margin="0,5,0,0"/>
            
        </StackPanel>

        <StackPanel Grid.Row="1" 
                    Margin="20,0,20,0" 
                    Orientation="Horizontal">
            
            <TextBlock Text="Caută după pacient:"
                       VerticalAlignment="Center" 
                       Margin="0,0,10,0" 
                       FontWeight="SemiBold"/>
            
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     Width="300" 
                     Height="30" 
                     VerticalContentAlignment="Center" 
                     Padding="5,0"/>
            
        </StackPanel>

        <Border Grid.Row="2" 
                Background="White" 
                Margin="20,10,20,20"
                CornerRadius="10">
            
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" 
                                  Direction="270" 
                                  ShadowDepth="2" 
                                  Opacity="0.1"/>
            </Border.Effect>

            <DataGrid ItemsSource="{Binding IstoricProgramariView}" 
                     IsReadOnly="True"
                     AutoGenerateColumns="False" 
                     CanUserAddRows="False" 
                     GridLinesVisibility="Horizontal" 
                     Background="White" 
                     BorderThickness="0"
                     Margin="10"
                     HeadersVisibility="Column"
                     RowHeight="35">

                <DataGrid.Resources>
                    
                    <!-- aspectul antetelor -->
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                    </Style>
                    
                </DataGrid.Resources>

                <DataGrid.Columns>
                    
                    <DataGridTextColumn Header="ID Prog."
                                        Binding="{Binding Id}" 
                                        Width="80"/>

                    <DataGridTextColumn Header="Nume Pacient" Width="2*">
                        
                        <!-- Scrierea numelui si a prenumelui impreuna -->
                        <DataGridTextColumn.Binding>
                            <MultiBinding StringFormat="{}{0} {1}">
                                <Binding Path="Client.Nume"/>
                                <Binding Path="Client.Prenume"/>
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                        
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Data Consultației" 
                                        Binding="{Binding DataOra, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" 
                                        Width="1.5*"/>

                    <DataGridTextColumn Header="Serviciu" 
                                        Binding="{Binding Serviciu.Denumire}" 
                                        Width="*"/>

                    <DataGridTextColumn Header="Preț (RON)" 
                                        Binding="{Binding Serviciu.Pret, StringFormat='{}{0:F2} RON'}" 
                                        Width="*">
                        
                        <!-- Schimbă aspectul pretului-->
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#27AE60"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>