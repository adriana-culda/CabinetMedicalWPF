<Window x:Class="CabinetMedical.Views.Admin.ServiciuModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalii Serviciu" Height="450" Width="400"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="ToolWindow"
        Background="#F5F7FA">

    <Border Background="White" Margin="15" CornerRadius="5">
        
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" 
                              ShadowDepth="1" 
                              Opacity="0.1"/>
        </Border.Effect>

        <StackPanel Margin="20">
            
            <TextBlock Text="Denumire Serviciu:" 
                       FontWeight="Bold" 
                       Margin="0,0,0,5"/>
            
            <TextBox Text="{Binding ServiciuCurent.Denumire}" 
                     Margin="0,0,0,15"
                     Padding="5" />

            <TextBlock Text="Categorie (ex: Cardiologie, Analize):" 
                       FontWeight="Bold" 
                       Margin="0,0,0,5"/>
            
            <TextBox Text="{Binding ServiciuCurent.Categorie}" 
                     Margin="0,0,0,15" 
                     Padding="5" />

            <Grid Margin="0,0,0,15">
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    
                    <TextBlock Text="Preț (RON):"
                               FontWeight="Bold" 
                               Margin="0,0,0,5"/>
                    
                    <TextBox Text="{Binding ServiciuCurent.Pret}" 
                             Padding="5"/>
                    
                </StackPanel>

                <StackPanel Grid.Column="2">
                    
                    <TextBlock Text="Durată (Minute):" 
                               FontWeight="Bold"
                               Margin="0,0,0,5"/>
                    
                    <TextBox Text="{Binding ServiciuCurent.DurataMInute}" 
                             Padding="5"/>
                    
                </StackPanel>
                
            </Grid>

            <TextBlock Text="Doctorul alocat acestui serviciu:" 
                       Margin="0,10,0,5" 
                       FontWeight="SemiBold"/>
            
            <ComboBox ItemsSource="{Binding ListaDoctori}"
                      SelectedItem="{Binding DoctorSelectat}" 
                      Margin="0,0,0,15"
                      Height="30">
                
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            
                            <TextBlock Text="{Binding Nume}" 
                                       FontWeight="Bold"/>
                            
                            <TextBlock Text=" "/>
                            
                            <TextBlock Text="{Binding Prenume}"/>
                            
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
                
            </ComboBox>

            <CheckBox IsChecked="{Binding ServiciuCurent.EsteActiv}"
                      Content="Serviciul este activ și disponibil" 
                      FontWeight="Bold" 
                      Margin="0,0,0,25"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right" 
                        Margin="0,10,0,0">

                <Button Content="Anulează" 
                        Command="{Binding CancelCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Width="100" 
                        Height="35" 
                        Margin="0,0,10,0" 
                        Background="#E0E0E0" 
                        BorderThickness="0" 
                        FontWeight="Bold" 
                        Cursor="Hand"/>

                <Button Content="Salvează" 
                        Command="{Binding SaveCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Width="100" 
                        Height="35" 
                        Background="#00B4D8" 
                        Foreground="White" 
                        BorderThickness="0" 
                        FontWeight="Bold" 
                        Cursor="Hand"/>

            </StackPanel>
            
        </StackPanel>
    </Border>
</Window>