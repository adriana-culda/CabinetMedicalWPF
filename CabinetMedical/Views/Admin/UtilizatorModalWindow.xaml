<Window x:Class="CabinetMedical.Views.Admin.UtilizatorModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalii Utilizator" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="ToolWindow"
        Background="#F5F7FA">

    <Border Background="White" Margin="15" CornerRadius="5">
        
        <Border.Effect>
            <DropShadowEffect BlurRadius="10"
                              ShadowDepth="1"
                              Opacity="0.1"/>
        </Border.Effect>

        <StackPanel Margin="20">
            
            <TextBlock Text="Nume Utilizator (Username):"
                       FontWeight="Bold" 
                       Margin="0,0,0,5"/>
            
            <TextBox Text="{Binding UtilizatorCurent.NumeUtilizator}" 
                     Margin="0,0,0,15" 
                     Padding="5"/>

            <TextBlock Text="Parolă:" 
                       FontWeight="Bold" 
                       Margin="0,0,0,5"/>
            
            <TextBox Text="{Binding UtilizatorCurent.ParolaHash}" 
                     Margin="0,0,0,15" 
                     Padding="5"/>

            <Grid Margin="0,0,0,15">
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    
                    <TextBlock Text="Nume:" 
                               FontWeight="Bold"
                               Margin="0,0,0,5"/>
                    
                    <TextBox Text="{Binding UtilizatorCurent.Nume}" 
                             Padding="5"/>
                    
                </StackPanel>
                
                <StackPanel Grid.Column="2">
                    
                    <TextBlock Text="Prenume:" 
                               FontWeight="Bold"
                               Margin="0,0,0,5"/>
                    
                    <TextBox Text="{Binding UtilizatorCurent.Prenume}"
                             Padding="5"/>
                    
                </StackPanel>
                
            </Grid>

            <Grid Margin="0,0,0,15">
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    
                    <TextBlock Text="Telefon:" 
                               FontWeight="Bold" 
                               Margin="0,0,0,5"/>
                    <TextBox Text="{Binding UtilizatorCurent.Telefon}"
                             Padding="5"/>
                    
                </StackPanel>
                
                <StackPanel Grid.Column="2">
                    
                    <TextBlock Text="Rol:" 
                               FontWeight="Bold" 
                               Margin="0,0,0,5"/>
                    
                    <ComboBox x:Name="ComboRol" 
                              SelectedItem="{Binding UtilizatorCurent.Rol}" 
                              Padding="5">
                        
                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Admin</System:String>
                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Doctor</System:String>
                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Asistentă</System:String>
                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Pacient</System:String>
                        
                    </ComboBox>
                </StackPanel>
            </Grid>
            
            <!-- Partea de atribuire asistentei unui doctor -->
            <StackPanel Margin="0,0,0,25">
                
                <StackPanel.Style>
                    
                    <Style TargetType="StackPanel">
                        
                        <Setter Property="Visibility"
                                Value="Collapsed"/>
                        
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem, ElementName=ComboRol}" 
                                         Value="Asistentă">
                                <Setter Property="Visibility" 
                                        Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    
                </StackPanel.Style>

                <TextBlock Text="Alege Doctorul Asociat:" 
                           FontWeight="Bold"
                           Foreground="#e74c3c" 
                           Margin="0,0,0,5"/>
                
                <ComboBox ItemsSource="{Binding ListaDoctori}" 
                          SelectedValue="{Binding UtilizatorCurent.DoctorAsociatId}" 
                          SelectedValuePath="Id" 
                          Padding="5">
                    
                    <ComboBox.ItemTemplate>
                        
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                
                                <TextBlock Text="Dr." 
                                           FontWeight="SemiBold" 
                                           Foreground="Gray" 
                                           Margin="0,0,3,0"/>
                                <TextBlock Text="{Binding Nume}" 
                                           FontWeight="Bold"/>
                                
                                <TextBlock Text=" "/>
                                
                                <TextBlock Text="{Binding Prenume}"/>
                                
                            </StackPanel>
                        </DataTemplate>
                        
                    </ComboBox.ItemTemplate>
                    
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        Margin="0,10,0,0">
                
                <Button Content="Anulează" 
                        Command="{Binding CancelCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Width="100" 
                        Height="35" 
                        Margin="0,0,10,0" 
                        Background="#E0E0E0" 
                        BorderThickness="0" 
                        FontWeight="Bold" 
                        Cursor="Hand"/>

                <Button Content="Salvează" 
                        Command="{Binding SaveCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Width="100"
                        Height="35"
                        Background="#00B4D8"
                        Foreground="White"
                        BorderThickness="0" 
                        FontWeight="Bold" 
                        Cursor="Hand"/>
            </StackPanel>
            
        </StackPanel>
        
    </Border>
</Window>