<UserControl x:Class="CabinetMedical.Views.Admin.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="#F5F7FA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
            
            <Border Width="200" 
                    Height="100" 
                    Background="#9b59b6" 
                    CornerRadius="10" 
                    Margin="10">
                
                <StackPanel VerticalAlignment="Center">
                    
                    <TextBlock Text="Pacienți" 
                               Foreground="White" 
                               HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="{Binding TotalPacienti}" 
                               Foreground="White" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center"/>
                    
                </StackPanel>
                
            </Border>
            
            <Border Width="200" 
                    Height="100" 
                    Background="#3498db" 
                    CornerRadius="10"
                    Margin="10">
                
                <StackPanel VerticalAlignment="Center">
                    
                    <TextBlock Text="Programări" 
                               Foreground="White" 
                               HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="{Binding TotalProgramari}" 
                               Foreground="White" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center"/>
                    
                </StackPanel>
               
            </Border>
            
            <Border Width="200"
                    Height="100" 
                    Background="#e67e22" 
                    CornerRadius="10" 
                    Margin="10">
                
                <StackPanel VerticalAlignment="Center">
                    
                    <TextBlock Text="Încasări" 
                               Foreground="White" 
                               HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="{Binding TotalIncasari, StringFormat='{}{0:F2} RON'}" 
                               Foreground="White" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center"/>
                    
                </StackPanel>
                
            </Border>
            
        </WrapPanel>

        <Border Grid.Row="1"
                Background="White" 
                CornerRadius="10" 
                Padding="10" 
                Margin="10">
            
            <!-- Graficul -->
            <lvc:CartesianChart Series="{Binding Series}"
                                XAxes="{Binding XAxes}" 
                                LegendPosition="Bottom"/>
            
        </Border>
        
    </Grid>
</UserControl>