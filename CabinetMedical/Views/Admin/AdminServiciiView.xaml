<UserControl x:Class="CabinetMedical.Views.Admin.AdminServiciiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="540" d:DesignWidth="780">

    <Grid Background="#F5F7FA">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Catalog Servicii și Prețuri" 
                   FontSize="20"
                   FontWeight="Bold" 
                   Margin="20,20,0,0" 
                   Foreground="#2C3E50"/>

        <StackPanel Grid.Row="1" 
                    Margin="20,10,20,0" 
                    Orientation="Horizontal">
            
            <TextBlock Text="Caută:" 
                       VerticalAlignment="Center" 
                       Margin="0,0,10,0" 
                       FontWeight="SemiBold"/>
            
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     Width="300" 
                     Height="30" 
                     VerticalContentAlignment="Center" 
                     Padding="5,0"/>
            
        </StackPanel>

        <Border Grid.Row="2"
                Background="White" 
                Margin="20,10,20,20" 
                CornerRadius="10">
            
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" 
                                  Direction="270" 
                                  ShadowDepth="2" 
                                  Opacity="0.1"/>
            </Border.Effect>

            <DataGrid ItemsSource="{Binding ServiciiView}" 
                     SelectedItem="{Binding SelectedServiciu}"
                     IsReadOnly="True"
                     AutoGenerateColumns="False" 
                     CanUserAddRows="False" 
                     GridLinesVisibility="Horizontal" 
                     Background="White" 
                     BorderThickness="0"
                     Margin="10"
                     HeadersVisibility="Column"
                     RowHeight="35">

                <DataGrid.Resources>

                    <!-- aspectul antetelor -->
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                    </Style>
                    
                </DataGrid.Resources>

                <DataGrid.Columns>
                    
                    <DataGridTextColumn Header="Denumire Serviciu" 
                                        Binding="{Binding Denumire}" 
                                        Width="2*"/>
                    
                    <DataGridTextColumn Header="Categorie" 
                                        Binding="{Binding Categorie}"
                                        Width="1.5*"/>

                    <DataGridTextColumn Header="Doctor" 
                                        Binding="{Binding Doctor.Nume}"
                                        Width="1.5*"/>

                    <DataGridTextColumn Header="Durată"
                                        Binding="{Binding DurataMInute, StringFormat='{}{0} min'}"
                                        Width="*"/>
                    
                    <DataGridTextColumn Header="Preț" 
                                        Binding="{Binding Pret, StringFormat='{}{0:F2} RON'}"
                                        Width="*"/>
                    
                    <DataGridCheckBoxColumn Header="Activ" 
                                            Binding="{Binding EsteActiv}" 
                                            Width="80"/>
                    
                </DataGrid.Columns>
                
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal"
                    HorizontalAlignment="Right" 
                    Margin="0,0,20,20">
            
            <Button Content="Modifică (Edit)" 
                   Command="{Binding EditServiciuCommand}"
                   Width="150" 
                   Height="35" 
                   Margin="5"
                   Background="#90E0EF" 
                   BorderThickness="0" 
                   FontWeight="Bold" 
                   Cursor="Hand"/>
            
            <Button Content="Șterge (Remove)"
                   Command="{Binding RemoveServiciuCommand}"
                   Width="150" 
                   Height="35"
                   Margin="5" 
                   Background="#FF7F7F" 
                   BorderThickness="0" 
                   FontWeight="Bold" 
                   Foreground="White" 
                   Cursor="Hand"/>
            
            <Button Content="Adaugă Serviciu"
                   Command="{Binding AddServiciuCommand}"
                   Width="150" 
                   Height="35"
                   Margin="5" 
                   Background="#00B4D8" 
                   Foreground="White" 
                   BorderThickness="0"
                   FontWeight="Bold"
                   Cursor="Hand"/>
            
        </StackPanel>
    </Grid>
    
</UserControl>