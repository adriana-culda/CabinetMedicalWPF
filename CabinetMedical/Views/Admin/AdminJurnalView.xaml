<UserControl x:Class="CabinetMedical.Views.Admin.AdminJurnalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="540" d:DesignWidth="780">

    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Jurnal Audit (Activitate Sistem)" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Margin="20" 
                   Foreground="#2C3E50"/>

        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding JurnalList}" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True" 
                  Margin="20"
                  HeadersVisibility="Column" 
                  GridLinesVisibility="Horizontal">
            
            <DataGrid.Columns>
                
                <DataGridTextColumn Header="Data" 
                                    Binding="{Binding DataOra, StringFormat='dd/MM/yyyy HH:mm'}" 
                                    Width="150"/>
                
                <DataGridTextColumn Header="Acțiune" 
                                    Binding="{Binding Actiune}"
                                    Width="150"/>
                
                <DataGridTextColumn Header="Entitate" 
                                    Binding="{Binding Entitate}"
                                    Width="120"/>
                
                <DataGridTextColumn Header="Detalii"
                                    Binding="{Binding Detalii}" 
                                    Width="*"/>
                
            </DataGrid.Columns>
            
        </DataGrid>
    </Grid>
</UserControl>